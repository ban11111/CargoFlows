MYSQL_IMAGE=mysql:8.4
MINIO_IMAGE=minio/minio:latest
MYSQL_VOLUME_NAME=cargoflows-prod-mysql
MINIO_VOLUME_NAME=cargoflows-prod-minio
MYSQL_DATABASE=cargoflows
MYSQL_USER=cargoflows
MYSQL_PASSWORD=replace-with-generated-value
MYSQL_ROOT_PASSWORD=replace-with-generated-value
MINIO_ROOT_USER=replace-with-generated-value
MINIO_ROOT_PASSWORD=replace-with-generated-value
MINIO_BUCKET=cargoflows
MINIO_AI_BUCKET=cargoflows-ai-private
JWT_SECRET=replace-with-generated-value
CARGOFLOWS_SECRETS_MASTER_KEY=copy-existing-base64-master-key
AI_WORKER_DRY_RUN=false
AI_WORKER_POLL_INTERVAL=1s
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-terra
OPENAI_IMAGE_TOOL_MODEL=gpt-5.6
OPENAI_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT=300s
OPENAI_IMAGE_REQUEST_TIMEOUT=600s
